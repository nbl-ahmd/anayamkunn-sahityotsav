# Neon Postgres connection (required for production persistence)
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB_NAME?sslmode=require

# Vercel Blob token (required for admin poster uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password

# Strong secret used to sign admin session cookies
ADMIN_AUTH_SECRET=replace_with_long_random_secret
